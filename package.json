{
  "name": "url-shortener",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic SDLC orchestration scaffolding for a URL shortener",
  "scripts": {
    "plan": "tsx orchestrator/runner.ts --plan",
    "run": "tsx orchestrator/runner.ts",
